# Nach dem Kopieren zu ".env" mit echten Werten fuellen.
# .env NICHT einchecken (enthaelt Zugangsdaten).

POSTGRES_PASSWORD=change-me

APP_USERNAME=notfall
# Hash erzeugen mit:
#   python3 -c "from werkzeug.security import generate_password_hash as h; print(h('DEIN-PASSWORT'))"
# WICHTIG: der erzeugte Hash enthaelt "$"-Zeichen (z.B. scrypt:32768:8:1$abc$def...).
# Docker Compose interpretiert einzelne "$" in .env als Variablenreferenz und
# schneidet den Wert sonst an dieser Stelle ab -- jedes "$" im Hash hier daher
# durch "$$" ersetzen (z.B. scrypt:32768:8:1$$abc$$def...).
APP_PASSWORD_HASH=change-me

# Zufaelligen Wert erzeugen mit: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

IMPORT_SCAN_INTERVAL_SECONDS=300
